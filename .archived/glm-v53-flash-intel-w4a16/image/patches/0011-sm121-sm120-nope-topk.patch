-                    "FLASHINFER_MLA_SPARSE_SM120 requires index_topk=2048; "
-                    f"got {index_topk}"
+                    "FLASHINFER_MLA_SPARSE_SM120 requires an effective topk "
+                    f"buffer width of 2048; got {eff_width} "
+                    f"(index_topk={index_topk}, index_kpool={kpool})"
                 )
         return None
 
