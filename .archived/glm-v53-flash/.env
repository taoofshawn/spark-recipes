# === Shared Configuration ===

# Multi-node — leader node IP (same for both nodes)
MASTER_ADDR=192.168.0.170

# Serve port (all local recipes use 4000; overridable per deploy)
PORT=4000
# DFlash2 block-diffusion drafter (opt-in; 2.15x single-stream vs MTP upstream).
# CHECKPOINT LICENSE: CC-BY-NC-ND-4.0 — NON-COMMERCIAL use only (base model is MIT).
# Requires incoai/GLM-5.3-Flash-DFlash2 (rev 7d74cdd…) on BOTH nodes. When set,
# SPEC_TOKENS is forced to 7 and the KV pin drops to 3 GiB (upstream shipped value).
DFLASH2=1
# DFlash2 requires SPEC_TOKENS=7 (drafter block size 8 - 1); the compose
# FATAL-error if it receives any other value. MTP default is 3.
SPEC_TOKENS=7

# Host HF cache path (shared by both nodes; container path is /cache/huggingface).
# Must hold the RedHatAI/GLM-5.3-Flash-NVFP4 snapshot on BOTH nodes (~184 GiB;
# offline serving). Checkpoint switched 2026-08-30 from LibertAIDAI
# (ModelOpt weight-only): ModelOpt builds emit intermittent corrupted token IDs
# that desync tool-call parsing (vllm#54150, 2x GB10 confirmation in upstream
# issue #10). RedHatAI compressed-tensors is drop-in — same flags, ~2x faster
# load (11 shards vs 120). NOTE: it does NOT ship chat_template_mm.jinja; our
# TEMPLATE_FIX layer (patches/, --chat-template) covers the vision template.
# LOCAL weights on both ranks is what unlocks the 672K-token
# KV pool — see RESEARCH.md (the NFS-shared ceiling is ~507K).
HF_CACHE=/home/sdrew/.cache/huggingface

# Host JIT/compile-cache root. MUST stay on node-local disk, never a shared/NFS
# mount (same rule as the DeepSeek recipes' /vllm-cache). Container path is
# /glm-cache.
JIT_CACHE_DIR=/home/sdrew/.cache/vllm-glm53

# === Network Interface Definitions ===
# Each physical interface is defined once, then referenced by env vars below.
# Change these to match your node's interface names.

# Main ethernet interface (control plane: GLOO, MPI, TP)
ETH_IF=enp1s0f0np0

# Secondary ethernet interface (port 2; for multi-interface NCCL socket)
ETH_IF2=enP2p1s0f0np0

# InfiniBand/RoCE HCA ports (data plane: NCCL IB)
IB_PORTS=rocep1s0f0,roceP2p1s0f0

# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot; set e.g. 0/2/3
# only if auto-detection ever picks the wrong GID.
NCCL_IB_GID_INDEX=

# Optional NCCL IB address filter (tonyd2wild GLM sets it; unset here because
# the DeepSeek recipes run fine without it). Set to your RoCE subnet only if
# NCCL picks the wrong device.
#NCCL_IB_ADDR_RANGE=192.168.0.0/24
