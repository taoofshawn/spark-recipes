# === Shared Configuration ===
# Adoption of 0rand/DeepSeek-v4-flash-ver-2sparks-vllm-029-0rand (see README.md
# for provenance). Cluster-specific values only — the serving profile knobs
# live here too so a single file drives both nodes. Read the README before
# changing the measured knobs (GMU / batch / seqs / MTP are image-tuned).

# Multi-node — leader node IP (same for both nodes)
MASTER_ADDR=192.168.0.170

# Serve port (all local recipes use 8000)
PORT=8000

# Host HF cache path (container path is /cache/huggingface). The Vision-Exp
# snapshot must be cached on BOTH nodes (TP=2 reads it on every rank).
HF_CACHE=/home/sdrew/.cache/huggingface

# Host JIT/compile-cache root: MUST stay on node-local disk (both ranks write
# concurrently). Container: /vllm-cache.
JIT_CACHE_DIR=/home/sdrew/.cache/vllm-dspark-0rand

# === Network Interface Definitions ===
ETH_IF=enp1s0f0np0
ETH_IF2=enP2p1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0

# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot (GID renumbers
# across reboots; the command block resolves it per node).
NCCL_IB_GID_INDEX=

# === Runtime image (digest-pinned Dickson vLLM 0.29-b12x build) ===
# The Dickson image is the updated PilcoTHINK Dockerfile lane (commit
# 38db013b, 2026-09-09): same vLLM base 6fbb00b1, but it BAKES IN the upstream
# DeepSeek V4 tool-call parser fix (vllm/parser/deepseek_v4.py from vLLM
# d98c8c03, "[Bugfix] Parse DSML tool calls when the model omits the tool_calls
# wrapper" #55954). 0rand's own image (85eb91ee) predates that fix; the parser
# fix is the measured delta behind Dickson's 93/100 vs 86/100 tool-eval-bench.
# Provenance: forum post #194 (Dickson), #185 (PILCOTHINK), #212 (stu.miller).
DSPARK_VLLM_IMAGE=dicksondickson/vllm_spark_dsv4:0.29-b12x@sha256:899d174eda297be3cfdd982f96e7c88b481cc0c945401f30b715b5f900f42ce4

# === Model (native Vision-Exp) ===
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
# 86f746b3 (also the sibling vision recipe's pin; byte-identical weights to
# HEAD 6821d6ad and to the cached refs/main e46e16bf — 48 shards each).
# Cached complete on both nodes. Pin explicitly for reproducibility.
DSPARK_REVISION=86f746b36186f0e567729a5c06a8c918caba82a9
SERVED_MODEL_NAME=deepseek-v4-flash

# === Serving profile (validated on 0rand's 2x GB10 kit) ===
# GMU ceiling on GB10 is 0.877 (106.77/121.69 GiB free at boot); 0.9 crashes.
# 0.87 is tight-but-valid; 0.85 is the conservative proven value.
GPU_MEMORY_UTILIZATION=0.87
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=8
# ~3M-token KV pool @ batch 4096 / GMU 0.87. Upstream's perf table measured
# 2048 as the acceptance optimum (~3.9M pool, +1.5x tg t/s at c8) but 4096 is
# its shipped best-settings value and the 93/100 tool-eval receipt config;
# 1024 gives the biggest pool (upstream: 4M).
MAX_NUM_BATCHED_TOKENS=4096
MAX_CUDAGRAPH_CAPTURE_SIZE=48
# DSpark k: MUST be divisible by the drafter's n_predict=3 (validator rejects
# 5). k=6 is upstream's validated value (k=3 was found to brain-damage the
# thinking process, forum post #171; ~5% speed loss vs 3, none vs 5+).
MTP_NUM_TOKENS=6
DRAFT_SAMPLE_METHOD=probabilistic
# Native vision: image_url content parts, max 10 images per prompt (GLM
# recipe parity; upstream default 8). --skip-mm-profiling is mandatory.
LIMIT_MM_PER_PROMPT=image=10

# === Sampling defaults (repo parity) ===
# temp 1.0 / top_p 0.95 / thinking ON at effort high — same explicit pins as
# the aiden and GLM recipes. Clients override per request via
# chat_template_kwargs / the OpenAI reasoning_effort field.
TEMPERATURE=1.0
TOP_P=0.95
THINKING=true
REASONING_EFFORT=high

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
