# === Shared Configuration ===
# Adoption of MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark (see README.md
# for provenance). Cluster-specific values only — the serving profile knobs
# live here too so a single file drives both nodes.

# Multi-node — leader node IP (same for both nodes)
MASTER_ADDR=192.168.0.170

# Serve port (all local recipes use 4000)
PORT=4000

# Host HF cache path (container path is /cache/huggingface). The Vision-Exp
# snapshot (revision below) must be cached on BOTH nodes (TP=2 reads it on
# every rank).
HF_CACHE=/home/sdrew/.cache/huggingface

# Host JIT/compile-cache root: MUST stay on node-local disk (upstream issue
# #27 — seven caches written concurrently by both ranks). Container: /vllm-cache.
JIT_CACHE_DIR=/home/sdrew/.cache/vllm-dspark-miaai

# === Network Interface Definitions ===
ETH_IF=enp1s0f0np0
ETH_IF2=enP2p1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0

# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot (GID renumbers
# across reboots; the command block resolves it per node).
NCCL_IB_GID_INDEX=

# === Runtime image (digest-pinned Anemll DSpark vLLM GX10 build) ===
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

# === Model (native Vision-Exp) ===
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
DSPARK_REVISION=86f746b36186f0e567729a5c06a8c918caba82a9
SERVED_MODEL_NAME=deepseek-v4-flash

# === Serving profile (validated on MiaAI-Lab's 2x GB10 kit) ===
# 0.83: Vision-Exp's ViT takes more weight RAM than the 0731 text model;
# the 2.33M-token nvfp4_ds_mla KV pool below was measured at this value.
GPU_MEMORY_UTILIZATION=0.83
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=1024
MTP_NUM_TOKENS=6
DRAFT_SAMPLE_METHOD=probabilistic
DEFAULT_THINKING=low
# Native vision: image_url content parts, max 8 images per request.
LIMIT_MM_PER_PROMPT=image=8
# Issue #27: max concurrent in-flight partial prefills (1-3; keep 1).
DSPARK_MAX_INFLIGHT_PREFILLS=1

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
