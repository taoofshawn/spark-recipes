# === Shared Configuration ===

# Multi-node — leader node IP (same for both nodes)
MASTER_ADDR=192.168.0.170

# Serve port (all local recipes use 4000; overridable per deploy)
PORT=4000

# Host HF cache path (shared by both nodes; container path is /cache/huggingface).
# The DeepSeek-V4-Flash-Vision-Exp snapshot must be cached on BOTH nodes.
HF_CACHE=/home/sdrew/.cache/huggingface

# Host JIT/compile-cache root (upstream issue #27): MUST stay on node-local
# disk, never on a shared/NFS mount — seven caches are written concurrently
# by both ranks. Container path is /vllm-cache.
JIT_CACHE_DIR=/home/sdrew/.cache/vllm-vision

# === Network Interface Definitions ===
# Each physical interface is defined once, then referenced by env vars below.
# Change these to match your node's interface names.

# Main ethernet interface (control plane: GLOO, MPI, TP)
ETH_IF=enp1s0f0np0

# Secondary ethernet interface (port 2; for multi-interface NCCL socket)
ETH_IF2=enP2p1s0f0np0

# InfiniBand/RoCE HCA ports (data plane: NCCL IB)
IB_PORTS=rocep1s0f0,roceP2p1s0f0

# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot; set e.g. 0/2/3
# only if auto-detection ever picks the wrong GID.
NCCL_IB_GID_INDEX=
