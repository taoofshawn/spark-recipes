+          sels[i] = -INFINITY;
+        }
+      }
+  #pragma unroll
+      for (int mask = 16; mask > 0; mask >>= 1) {
+        w += VLLM_SHFL_XOR_SYNC(w, mask);
+      }
+      slot_expert[j] = best_e;
+      slot_weight[j] = w;
