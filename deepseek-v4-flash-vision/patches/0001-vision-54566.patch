+def test_flashinfer_mixed_sparse_indices_with_image_spans():
+    device = torch.device("cuda")
+    # 1 decode token (req 0) + two prefill requests (reqs 1, 2).
+    seq_lens = [20, 30, 9]
+    query_lens = [1, 30, 9]
+    spans = [[], [(4, 12)], [(0, 6)]]
