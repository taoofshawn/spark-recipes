# shawndo site env for deepseek-v41-flash-tp4-switchless — knapcio stack
# (upstream github.com/knapcio/DeepSeek-V4.1-Flash-4x-DGX-Spark-TP4 @ aff52fa, vendored
# 2026-10-26; vehicle swap from the MiaAI-Lab lane — see research.md 2026-10-26 entry
# and upstream/VENDORED-AT.md. On-node paths keep the historical ds41f-miaai name).
# Consumed by ../upstream/start.sh (ENV_FILE=.env.tp4-switchless, rendered by
# ../site/start-cluster.sh).
#
# Cluster values are THIS cluster's four-PF switchless contract, identical to the
# glm-v53-flash-nvfp4-tp4-switchless site env. Model stack values are knapcio's
# .env.tp4.example TP4 production profile (the "Production profile (the README's
# current results)" block) with the switchless-ring block and this site's values.

# --- cluster: hosts + management LAN ---------------------------------------------------
# Head = rank 0; workers in TP-rank order 1..3.
HEAD_IP=10.69.43.170
WORKER_IPS="10.69.43.171 10.69.43.172 10.69.43.173"
WORKER_HOSTS="spark-6d14.shawndo.intra spark-6d90.shawndo.intra spark-6d24.shawndo.intra"
WORKER_USER=
# The launcher SSHes head→workers with SSH_IDENTITY (default ~/.ssh/id_ed25519_shared,
# absent here); empty WORKER_USER + this identity file (created at build step from the head's
# own key) keeps the standard head→worker ssh working. Overridden by site/start-cluster.sh
# if the key needs provisioning.
SSH_IDENTITY=$HOME/.ssh/id_ed25519

# --- fabric (four-PF switchless ring, shared cluster contract) --------------------------
# Gloo/NCCL TCP bootstrap on the mgmt NIC (10.69.43.0/16, wlP9s9) — NOT a fabric PF.
FABRIC_IFACE=wlP9s9
GLOO_SOCKET_IFNAME=wlP9s9
NCCL_SOCKET_IFNAME=wlP9s9
# All FOUR functions (both PCIe views per cable) — the site's Phase-E netplan + four-PF
# NCCL contract (additive over the old 2-PF plan; P2 addresses = f octet + 2).
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=WARN   # gate capture 2026-10-22 used INFO+NET once (see research.md); back to steady state
# MiaAI GB10 UMA pinned-buffer math (4.7 GiB → 0.14 GB): decode ARs are 61 KB LL.
# (measured on the MiaAI stack; carried over — same model, same ring)
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_DEBUG_SUBSYS=INIT,ENV   # add NET only while validating (docs/switchless-ring.md "Diagnosing it")
# The site's four-PF build (othexmr @ 94c2669 + site GID patch, SHA 8de68def…,
# SWITCHLESS_RING_ONLY marker verified on all four nodes 2026-10-21) replaces the
# knapcio default path $HOME/nccl-2.30.7. The launcher overlays it onto the container's
# pip NCCL (NCCL_OVERLAY_PIP=1, default under ring mode) and greps the marker.
NCCL_HOST_DIR=$HOME/.local/lib/nccl-patched-4pf

# --- switchless ring (appended block, mirrored here) ------------------------------------
NCCL_SWITCHLESS_RING_ONLY=1
NCCL_ALGO=Ring
NCCL_IB_SUBNET_PREFIX_LEN=24
NCCL_MIN_NCHANNELS=4
# Site delta vs knapcio's tested 4: the four-PF contract spreads channels over 4 devices;
# MAX 8 measured +8% c2 / +24% c4 on the retired sparkring lane (commit dade187) — kept.
NCCL_MAX_NCHANNELS=8
NCCL_P2P_LEVEL=SYS
# Four-HCA advertisement flags — REQUIRED with our four-PF contract (docs/switchless-ring.md
# "Devices past the second are never advertised"); reach every rank via EXTRA_CONTAINER_ENV.
# Every adapter switch must ride in this single line: start.sh's -e whitelist is narrower
# than the flag set (a plain assignment here never reaches the container — boot failure
# 2026-10-22, moe_b12x_next never armed; research.md 2026-10-22). The DSV41_* tail of the
# line is knapcio's production EXTRA_CONTAINER_ENV (.env.tp4.example "Production profile")
# verbatim, plus the site's four-PF NCCL flags, DSV41_DRAFT_HEAD_FP8_IMPL=tp4 (4-rank draft
# head sharding), SGLANG_DEFAULT_THINKING and the ring's NCCL advertisement flags.
EXTRA_CONTAINER_ENV="DSV41_INDEXER_CHUNKED=1 NCCL_IB_EXTENDED_IPV4_GIDS=1 NCCL_IB_PRESERVE_PCI_DOMAIN=1 NCCL_IB_ROUTE_DIAGNOSTICS=1 NCCL_IB_QPS_PER_CONNECTION=1 SGLANG_RUST_BUILD_MODE=never DSV41_FAST_LOAD=1 DSV41_FAST_LOAD_EP_SIZE=1 DSV41_FAST_LOAD_TP_SLICE=auto DSV41_FAST_LOAD_N_EXPERTS=384 DSV41_FAST_LOAD_INFLIGHT_GB=6 DSV41_DRAFT_HEAD_FP8_IMPL=tp4 DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_MAIN_PROJ_SPLIT=1 DSV41_ROUTER_LIVE=1 DSV41_MOE_B12X_NEXT=1 DSV41_MOE_B12X_NEXT_DETERMINISTIC=1 DSV41_HC_FUSED=1 DSV41_PREFILL_SP=1 DSV41_PREFILL_SP_FP8=1 DSV41_L2_PREFETCH=1 SGLANG_DEFAULT_THINKING=true SGLANG_DSPARK_FOLDED_SAMPLING=2 DSV41_ENGRAM_PREFETCH=1 DSV41_WO_A_W8=1 DSV41_DRAFT_TAU=0.7 DSV41_DRAFT_HEAD_FP8=1 DSV41_BLOCK_VERIFY=1 DSV41_FOLDED_FENCE=1 DSV41_VERIFY_CAP=conf:0.1 DSV41_AUTOTUNE_KEEP=1 DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1"

# --- weights: local on every node (a ring has no fabric-wide NFS path) ------------------
# Materialized real-file dirs (site/materialize-miaai-weights.sh hardlinks from the HF
# cache — the cache and destination share the root fs, so hardlinks cost zero data).
MODEL_DIR=$HOME/.local/ds41f-miaai/weights/deepseek-v41-flash-1017
COMMON_MODEL=/var/tmp/DeepSeek-V4.1-Flash-1017
NFS_SHARE=0
NFS_VOLUME=dsv41-local-weights

# --- model / image ----------------------------------------------------------------------
BASE_IMAGE=lmsysorg/sglang:dev-dsv41@sha256:3dbc313030a6ef2c5d7de8ecf48e9aece722694a82182cb618cc82b588816349
IMAGE=dsv41-4x-spark:canary-roce-knapcio
BUILD_DOCKERFILE=Dockerfile.canary-roce
# extra docker build args. The digest pin rides here because the vendored Dockerfile's
# ARG BASE_IMAGE defaults to the MUTABLE dev-dsv41 tag — both build paths (build-cluster.sh
# and the launcher's own `build`) consume BUILD_ARGS, so this pins every build to the same
# digest the pull check verifies. (script hard-requires the variable to exist under `set -u`)
BUILD_ARGS=--build-arg BASE_IMAGE=lmsysorg/sglang:dev-dsv41@sha256:3dbc313030a6ef2c5d7de8ecf48e9aece722694a82182cb618cc82b588816349
# Site serves on :8000 behind the model-name proxy (clients never change).
PORT=8000

# --- parallelism -------------------------------------------------------------------------
NNODES=4
TP_SIZE=4
# Production line (docs/tp4.md): every rank a 576-wide slice of all 384 experts, routed
# MoE on b12x_next — no EP-group straggler at the MoE all-reduce (5.9 → ~2.6 ms/step).
EP_SIZE=1
DIST_PORT=29541

# --- serving (MiaAI TP4 production profile) ----------------------------------------------
OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=4
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
CONTEXT_LENGTH=1048576
# 0.80 leaves ~24 GiB/rank outside the static pool for the prefill transient.
MEM_FRACTION_STATIC=0.80
HEAD_MEM_FRACTION_STATIC=0.80
MAX_RUNNING_REQUESTS=16
# 4096-token chunks are safe at any context WITH DSV41_INDEXER_CHUNKED=1 (armed above).
CHUNKED_PREFILL_SIZE=4096
# Pinned KV pool: 8,000,000 x 1,670.75 B = 13.4 GB/rank under the 0.80 budget.
MAX_TOTAL_TOKENS=8000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
# No SPS/STS tables: on this Engram model profiling a table crashes the engine
# (upstream WARNING in .env.tp4.example; DSpark runs the verify-all schedule).
DSPARK_SPS_TABLE=
DSPARK_STS_TABLE=

# --- engram local shards ------------------------------------------------------------------
ENGRAM_DIR=$HOME/.local/ds41f-miaai/engram
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
# Upstream rule #4 (README): run the FULL smoke once per bring-up — JSON, tools and the
# vision path, not just arithmetic. Kept ON so every bring-up re-runs it.
SMOKE_QUICK=0
# Thinking default aligned with the GLM lanes (owner decision 2026-10-23): the dsv4.1
# image DOES ship SGLANG_DEFAULT_THINKING (EnvBool, default False) — the older "no
# default-thinking flag exists" note was wrong. It is the per-request fallback when
# chat_template_kwargs omits thinking/enable_thinking (alias handled by
# adapter/encoding_compat); explicit client values still win. Must ride in
# EXTRA_CONTAINER_ENV (start.sh's -e whitelist does not cover it).
# --swa-full-tokens-ratio 0.3 (site delta 2026-10-26, second attempt — see research.md):
# the 2026-10-25/26 retention investigation narrowed the killer to finished-request
# inserts tombstoning their whole path (incl. shared nodes); the ONE boot that ever
# showed healthy idle retention was ratio-mode (SWA pool 419K/rank), and the #35515
# tail-deprioritization is now deployed to cover the cascade side. r=0.5 was rejected
# for c4 starvation (838K global vs ~810K agent working set); r=0.3 projects c4 ≈ 3.4M
# global (≈4x the working set) with swa ≈ 1M global. Gated at boot: c4_size ≥ 800K/rank.
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1 --enable-deepseek-v4-fp4-indexer --enable-cache-report --sleep-on-idle --enable-metrics --enable-mfu-metrics --swa-full-tokens-ratio 0.3"
DSV41_MXFP8_BACKEND=b12x
DSV41_SHARED_PAD_K=1
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
SGLANG_DSV41_REASONING_EFFORT=75
DSV41_MAX_NEW_TOKENS=32768
# Thinking-mode completion floor (site delta vs upstream default of 16384 in
# .env.tp4.example = same value, kept explicit): a thinking request sized for a
# non-reasoning client (MMLU's max_tokens=256) otherwise burns the entire budget
# in the reasoning segment and returns finish_reason=length with empty content.
# Measured 2026-10-22 on this lane: 50/500 MMLU items truncated, 42/50 answer
# correctly given headroom (+~9 points); IFEval 26/541 truncated. Bench clients
# under-reports rather than model loss — see research.md 2026-10-22.
DSV41_MAX_NEW_TOKENS_FLOOR=16384
DSV41_LOOP_ABORT=1
DSV41_LOOP_NGRAM=32
DSV41_LOOP_REPEATS=4
DSV41_LOOP_LINE_REPEATS=8
# PyTorch allocator: expandable_segments:True produced NaN logits for prefill >64 rows
# on GB10 (MiaAI REPORT.md §17); False also coalesces the square-growth prefill OOM.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192

# --- production adapter line (knapcio "Production profile" EXTRA_CONTAINER_ENV block) ------
# The lever set below is delivered through EXTRA_CONTAINER_ENV above (start.sh's -e
# whitelist does not carry these names):
#   DSV41_FAST_LOAD=1 DSV41_FAST_LOAD_EP_SIZE=1 DSV41_FAST_LOAD_TP_SLICE=auto DSV41_FAST_LOAD_N_EXPERTS=384 DSV41_FAST_LOAD_INFLIGHT_GB=6   (EP1+TP_SLICE=auto: boot ~25 → ~3 min; NOT at EP2 — fills UMA)
#   DSV41_ENGRAM_PREFETCH=1 DSV41_WO_A_W8=1 DSV41_DRAFT_TAU=0.7 DSV41_DRAFT_HEAD_FP8=1
#   DSV41_BLOCK_VERIFY=1 DSV41_FOLDED_FENCE=1 DSV41_VERIFY_CAP=conf:0.1 DSV41_AUTOTUNE_KEEP=1
#   DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1 SGLANG_DSPARK_FOLDED_SAMPLING=2
#   DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_MAIN_PROJ_SPLIT=1 DSV41_ROUTER_LIVE=1
#   DSV41_MOE_B12X_NEXT=1 DSV41_MOE_B12X_NEXT_DETERMINISTIC=1 DSV41_HC_FUSED=1
#   DSV41_PREFILL_SP=1 DSV41_PREFILL_SP_FP8=1 DSV41_L2_PREFETCH=1
#   DSV41_DRAFT_HEAD_FP8_IMPL=tp4 (site addition — 4-rank draft-head sharding)
#   SGLANG_DEFAULT_THINKING=true (below, owner decision 2026-10-23)
# DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192 (kept as a plain line below) matches the in-image
# adapter default, so delivery is unnecessary. DSV41_SHARED_PAD_K, DSV41_TP_PAD and the
# DSV41_LOOP_* knobs ARE in start.sh's -e whitelist and ride the plain lines.
# RoCEnante one-shot all-reduce stays OFF: a plain ring has no all-to-all RDMA path
# (SGLANG_ROCE_ALLREDUCE=0 is the profile default; the mesh/hairpin path is a later
# gated experiment, not part of this swap).
# SGLANG_RUST_BUILD_MODE=never — in EXTRA_CONTAINER_ENV above

# --- TP4 runtime ---------------------------------------------------------------------------
DSV41_TP_PAD=0
# Name the engine must serve. The model-name proxy's BACKEND_MODEL/SPOOF_FROM contract is
# this name; without this line start.sh falls back to upstream's default (deepseek-v4.1-flash)
# and clients would see the real name through the proxy.
SERVED_MODEL_NAME=deepseek-v41-flash
WORKER_DIR=$HOME/.local/ds41f-miaai
