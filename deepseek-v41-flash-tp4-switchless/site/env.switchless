# shawndo site env for deepseek-v41-flash-tp4-switchless (sparkring deepseek-v41-flash-cycle lane,
# serving deepseek-ai/DeepSeek-V4.1-Flash-1017 @ 1bae0e10 — weights-only successor of the
# sparkring-pinned DeepSeek-V4.1-Flash @ dba1be0a; config.json + 48-shard layout byte-identical).
#
# Cluster values (hosts, IPs, fabric, NCCL) are THIS cluster's four-PF switchless contract,
# identical to the glm-v53-flash-nvfp4-tp4-switchless site/env.switchless. Model stack values
# trace to upstream: recipes/deepseek-v41-flash-cycle.json @ sparkring ad1853fc + its checkpoint
# "1017" entry (profiles/deepseek-v41-flash-tp4/config.json).
#
# Consumed by site/start-cluster.sh, which resolves placeholders into per-rank env files for
# upstream/deepseek_v41_cycle_serve.sh (the sparkring launcher: --check validates, --run launches).

# --- cluster: hosts + management LAN (same as the GLM lanes) -----------------------------
HOSTS="local spark-6d14.shawndo.intra spark-6d90.shawndo.intra spark-6d24.shawndo.intra"
IPS="10.69.42.170 10.69.42.171 10.69.42.172 10.69.42.173"
# Bootstrap/socket interface for rendezvous + GLOO/NCCL sockets: mgmt NIC enP7s7
# (10.69.42.0/16) — NOT a fabric PF (per-link /24s reach only their peer).
NCCL_SOCKET_IFNAME=enP7s7
GLOO_SOCKET_IFNAME=enP7s7

# --- cluster: four-PF switchless transport contract (shared with the GLM lanes) ----------
# Shared four-PF NCCL build ~/.local/lib/nccl-patched-4pf (SHA 8de68def…, othexmr @ 94c2669 +
# one-line site GID patch — reproducible via glm-v53-flash-nvfp4-tp4-switchless/site/nccl-4pf/).
# The sparkring cycle lane's own contract is the SparkRing patched NCCL 2.30.7 (2 PFs) from its
# donor image; this site points the SAME bind-mount/LD_PRELOAD mechanism at the site's four-PF
# build instead — the four-PF lib serves both GLM lanes and is the validated ring transport
# here. Rollback (2-PF donor lib) is documented in site/start-cluster.sh + research.md.
NCCL_SO_HOST_PATH=$HOME/.local/lib/nccl-patched-4pf/libnccl.so.2.30.7
NCCL_SHA256=8de68def30bcde20fabded468bd60f0df82ea12d3ead02d5120c7feda7a41a87
# Four PFs — both PCIe views of every cable (additive netplan, GLM Phase E layout):
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
NCCL_IB_GID_INDEX=3
NCCL_IB_SUBNET_PREFIX_LEN=24
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=1
NCCL_ALGO=Ring
NCCL_PROTO=LL,LL128,Simple
NCCL_P2P_LEVEL=SYS
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_SKIP_TREE_CONNECT=1
NCCL_SWITCHLESS_RING_ONLY=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN

# --- model stack (upstream receipts) ------------------------------------------------------
# Checkpoint: deepseek-ai/DeepSeek-V4.1-Flash-1017 @ 1bae0e1088993b9b82de08f59de5be5a34e42170
# (MIT). Materialized by site/materialize-weights.sh (hardlinks from the HF cache).
MODEL_DIR=$HOME/.local/ds41f-tp4/weights/deepseek-v41-flash-1017
# Writable per-rank cache root (vLLM/FlashInfer/Triton/TVM-FFI caches + packed Engram shards):
CACHE_DIR=$HOME/.local/ds41f-tp4/cache
# Patched vLLM image built per-node from upstream/build-image.sh (upstream pin + receipt);
# IMAGE_ID pins identity — the launcher refuses a mismatch.
IMAGE=local/sparkring-deepseek-v41:overlay5
IMAGE_ID=

# --- serving values (upstream recipes/deepseek-v41-flash-cycle.json "recorded" profile) ---
API_PORT=8000
MASTER_PORT=29541
SERVED_MODEL_NAME=deepseek-v41-flash
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.83
NUM_SPECULATIVE_TOKENS=5
DRAFT_SAMPLE_METHOD=greedy
ENFORCE_EAGER=0
TEXT_ONLY=0
THINKING_DEFAULT=true
# Engram: balanced columns + packed single-read shards (measured prefill +15%: sparkring
# performance/records/deepseek-v41-flash/cycle-tp4-dspark5-graphs-20260910.md "Engram loader
# rebalance"). Packed shards are built once per rank by site/build-engram-packed.sh.
ENGRAM_DISK_THREADS=64
ENGRAM_DISK_CHUNK=16
ENGRAM_BALANCED=1
ENGRAM_PACKED_DIR=/cache/engram-packed
