# === Shared Configuration ===
# Adoption of Entrpi/glm-5.3-flash-exl3-2x-spark (see README.md for
# provenance). Cluster-specific values + Entrpi's validated serving profile.
# Every knob here is read by the compose command block (docker-compose.yml)
# and forwarded to `vllm serve` exactly like Entrpi's launcher does.

# Multi-node — leader node IP (same for both nodes; the RoCE rail)
MASTER_ADDR=192.168.0.170

# Serve port (cluster convention; Entrpi default is 8000)
PORT=4000
# vLLM rendezvous port (Entrpi's MPORT default is 29521)
MPORT=29521

# === Host paths (per node; contract with the mounts below) ===
# Flat EXL3 weights dir (snapshot_download-style layout, NOT HF hub layout).
# This is a hardlink-materialized copy of the Mia-AiLab 25a44fd snapshot
# (bytes identical to brandonmusic 5ab363a8); see README provisioning.
MODEL_HOST_PATH=/home/sdrew/models/glm53-exl3
# DFlash2 MXFP8 drafter (flat dir, downloaded by snapshot_download).
DFLASH_DIR=/home/sdrew/models/glm53-dflash2-mxfp8
# Cache root: container mounts this at /cache (HF_HOME=/cache/huggingface)
# and its jit/{triton,flashinfer,b12x,vllm} subdirs at the per-tool caches.
CACHE_HOST_PATH=/home/sdrew/.cache/glm53-entrpi

# === Network Interface Definitions (this cluster's validated NICs) ===
# Entrpi's launcher wires ONE rail interface per box; this cluster's convention
# (and every other recipe here) uses both CX7 ports. The primary names match
# Entrpi's defaults exactly (enp1s0f0np0 / rocep1s0f0).
ETH_IF=enp1s0f0np0
ETH_IF2=enP2p1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0
# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot (GID renumbers
# across reboots; the command block resolves it per node from sysfs).
NCCL_IB_GID_INDEX=
# Rail subnet for NCCL_IB_ADDR_RANGE (Entrpi's NCCL_SUBNET)
NCCL_SUBNET=192.168.0.0/24

# === Runtime image (Entrpi community-derivative; overlay baked) ===
# Digest-pinned 2026-09-04 at v2.3-tier1 (verified via GHCR manifest HEAD;
# pulled on both nodes). v1-dflash2 / v2-glmnext / v2.1-finegrain predate
# fine-grained prefix reuse and the 14.4 GB KV default — do NOT downpin.
IMAGE=ghcr.io/entrpi/glm-5.3-flash-exl3-2x-spark:v2.3-tier1@sha256:44b2dbafe8d81d6c7019a346480b49b23c1a0bef99c9b1d0db6e7ccc926921ca

# === Model ===
# Entrpi's loader reads the flat dir at /models/glm53-exl3 (bound above);
# the repo/branch of the bytes only matters at provisioning time.
SERVED_MODEL_NAME=glm-5.3-flash
# DFlash2 drafter repo + rev (Entrpi's validated MXFP8 pin from install.sh)
DFLASH_REPO=local-inference-lab/GLM-5.3-Flash-DFlash2-MXFP8
DFLASH_REVISION=62f758c0a0e19b9cb76fc098c911b8ed76daff5b

# === Serving profile (Entrpi's validated production configuration) ===
GMU=0.85
MAX_LEN=524288
MAX_SEQS=4
MNBT=8192
SPEC=dflash
DFLASH_TOKENS=7
MTP=0
EAGER=0
SKIP_MM_PROFILING=1
BLOCK_SIZE=2304
KV_DTYPE=fp8_ds_mla
KV_SKIP_LAYERS=sliding_window
# empty -> 14.4e9 (v2.2+ indexer right-sizes its workspace; nets more
# headroom than the old 12.4e9 pin). "auto" -> vLLM budgeting.
KV_CACHE_MEMORY=
MM_CACHE_GB=0.5
LOAD_FORMAT=instanttensor
ATTN_BACKEND=B12X_MLA_SPARSE
PREFIX_MATCH_UNIT=512
# v2.3 drafter defaults (FINDINGS §18-19)
VLLM_USE_B12X_FP8_GEMM=1
VLLM_DFLASH_FP8_DRAFT_HEAD=1
VLLM_B12X_MXFP8_MAX_M=16
NCCL_NCHANNELS=8

# === Alternative profiles (README "Choosing a configuration") ===
# Swap in one line at a time; values below are the DEFAULTS (commented),
# verbatim from Entrpi's env documentation.
# Snappy chat while documents upload:
#   MIXED_PREFILL_DECODE_WEIGHT=1.0  MIXED_PREFILL_CAP=512
# 1M-token requests: MAX_LEN=1048576 KV_DTYPE=nvfp4_ds_mla
#   VLLM_NVFP4_MLA_DYNAMIC_SCALE=1 MNBT=4096
# Many concurrent short sessions (agents): MAX_LEN=131072 MAX_SEQS=12
#   MNBT=4096 SPEC=none MIXED_PREFILL_DECODE_WEIGHT=1.0 MIXED_PREFILL_CAP=512
# Light interactive (smaller pool, no skip-mm-profiling? short MAX_LEN):
#   MAX_LEN=131072 KV_DTYPE= ATTN_BACKEND= SKIP_MM_PROFILING=0 MAX_SEQS=6

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
