# === Shared Configuration — glm-v53-flash-intel-w4a16-v029 ===
# Stock vLLM v0.29.0 image (official vllm/vllm-openai base, SM121 patch stack
# baked) serving the RAW Intel W4A16 AutoRound snapshot — no GPTQ surgery
# (INC auto-round is native on v0.29.0), no runtime overlays. mtp3 lane only.
# Cluster values are byte-identical to glm-v53-flash-intel-w4a16/.env unless
# noted. See README.md for deploy steps and docs/FLAGS-AUDIT.md for the
# v0.29.0 flag mapping.

# Multi-node — leader node IP (same for both nodes; the RoCE rail)
MASTER_ADDR=192.168.0.170

# Serve port (cluster convention)
PORT=8000
# vLLM rendezvous port
MPORT=29521

# Image — local tag built from image/ on this branch (docs/BUILD-RECEIPT.md);
# compose interpolates it into `image: ${IMAGE}`. Same convention as the
# legacy recipe's .env.
IMAGE=glm53-intel-w4a16-v029:20260920-r2

# === Host cache paths (per node) ===
# HF hub cache: the RAW Intel snapshot at MODEL_REVISION below — served
# directly (no surgery revision). Mounted at /cache/huggingface. Both nodes.
HF_CACHE=/home/sdrew/.cache/huggingface
# NOTE: node-local override for this recipe's JIT caches (separate from the
# legacy lane's cache dir so the two images never share inductor caches).
CACHE_HOST_PATH=/home/sdrew/.cache/glm53-intel-w4a16-v029

# === Network Interface Definitions (this cluster's validated NICs — byte-identical to legacy) ===
ETH_IF=enp1s0f0np0
ETH_IF2=enP2p1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0
# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot (GID renumbers
# across reboots; the command block resolves it per node from sysfs).
NCCL_IB_GID_INDEX=
# Rail subnet for NCCL_IB_ADDR_RANGE
NCCL_SUBNET=192.168.0.0/24

# === Model (Intel W4A16 AutoRound, RAW — no prepare-model.sh) ===
MODEL=Intel/GLM-5.3-Flash-W4A16-AutoRound
MODEL_REVISION=5eee1846f0321058ed73745f9aa16f2aaf0fc0a0
SERVED_MODEL_NAME=glm-5.3-flash

# === Serving profile (mtp3 default lane; carried from the legacy recipe —
# values were validated on the OLD image and are re-gated at bring-up on this
# one; see TESTING-RUNBOOK gates) ===
LANE=mtp3
PMU=1
GMU=0.85
MAX_LEN=1048576
MAX_SEQS=6
MNBT=8192
BLOCK_SIZE=2304
KV_DTYPE=fp8_e4m3
# 13.5 GB -> ~1.92M-token pool @1M ctx on the legacy image. v0.29.0's MRV2
# changed CUDA-graph/KV accounting — re-check the pool size at boot (Gate A).
# PIN TRAP unchanged: --kv-cache-memory-bytes bypasses the profiler activation
# check; too high = death on the first long prompt. Empty -> profiler sizes it.
KV_CACHE_MEMORY=13500000000
# MoE backend: leave EMPTY — v0.29's oracle auto-selects per layer class and
# this checkpoint is MIXED: the 45 quantized W4A16 layers' experts pick
# MARLIN automatically (same result as the legacy lane's explicit marlin),
# but the unquantized BF16 MTP/nextn layer carries its own experts and a
# forced marlin FATALs ("not supported for unquantized MoE", 2026-09-21).
# Diagnostic alternative (playbook): MOE_BACKEND=triton forces triton
# everywhere (~2x slower decode) — only for isolation boots.
MOE_BACKEND=
# 1 = --enforce-eager (CUDA graphs on by default)
EAGER=0
# 1 = --no-enable-flashinfer-autotune (costs ~50-85 s/boot, saved zero configs)
DISABLE_FLASHINFER_AUTOTUNE=1
# 1 = --async-scheduling (A/B'd neutral on the legacy stack; off by default)
ASYNC=0
# Sampling / thinking defaults — explicit recipe-owned pins (same values as
# the legacy lane; the baked chat_template_mm.jinja honors enable_thinking +
# reasoning_effort).
THINKING=true
REASONING_EFFORT=high
TEMPERATURE=1.0
TOP_P=0.95

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# === Alternative tuning rows (same semantics as legacy) ===
# smaller KV pool:  MAX_SEQS=6 KV_CACHE_MEMORY=9663676416
# 262K staging:     MAX_LEN=262144 KV_CACHE_MEMORY=3221225472 MAX_SEQS=6
# profiler-sized:   unset KV_CACHE_MEMORY
