# Multi-node — leader node IP (same for both nodes; the RoCE rail)
MASTER_ADDR=192.168.0.170

# Serve port (cluster convention)
PORT=8000
# vLLM rendezvous port
MPORT=29521

IMAGE=ghcr.io/taoofshawn/vllm-glm53-intel-w4a16:glm53flash-pmu128-mtp3

HF_CACHE=/home/sdrew/.cache/huggingface

# Node-local JIT caches (inductor/tilelang) — separate dir per recipe/image
# so inductor caches are never shared.
CACHE_HOST_PATH=/home/sdrew/.cache/glm53-intel-w4a16-v029

# === Network Interface Definitions (this cluster's validated NICs) ===
ETH_IF=enp1s0f0np0
ETH_IF2=enP2p1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0

# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot (GID renumbers
# across reboots; the command block resolves it per node from sysfs).
NCCL_IB_GID_INDEX=
# Rail subnet for NCCL_IB_ADDR_RANGE
NCCL_SUBNET=192.168.0.0/24

MODEL=Intel/GLM-5.3-Flash-W4A16-AutoRound
MODEL_REVISION=5eee1846f0321058ed73745f9aa16f2aaf0fc0a0
SERVED_MODEL_NAME=glm-5.3-flash

PMU=1
GMU=0.85
MAX_LEN=1048576
MAX_SEQS=6
MNBT=8192
BLOCK_SIZE=2304
KV_DTYPE=fp8_e4m3
# 13.5 GB -> ~1.92M-token pool @1M ctx. --kv-cache-memory-bytes bypasses the
# profiler activation check; too high = death on the first long prompt.
# Empty -> profiler sizes it.
KV_CACHE_MEMORY=13500000000
# MoE backend: leave EMPTY — v0.29's oracle auto-selects per layer class and
# this checkpoint is MIXED: the quantized W4A16 layers' experts pick MARLIN
# automatically, but the unquantized BF16 MTP/nextn layer carries its own
# experts and a forced marlin FATALs ("not supported for unquantized MoE").
# Diagnostic alternative (playbook): MOE_BACKEND=triton forces triton
# everywhere (~2x slower decode) — only for isolation boots.
MOE_BACKEND=
# 1 = --enforce-eager (CUDA graphs on by default)
EAGER=0
# 1 = --no-enable-flashinfer-autotune (autotune costs ~50-85 s/boot and
# saves zero configs)
DISABLE_FLASHINFER_AUTOTUNE=1
# 1 = --async-scheduling (off by default)
ASYNC=0
# Sampling / thinking defaults (the baked chat_template_mm.jinja honors
# enable_thinking + reasoning_effort).
THINKING=true
REASONING_EFFORT=high
TEMPERATURE=1.0
TOP_P=0.95

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# === Alternative tuning rows ===
# smaller KV pool:  MAX_SEQS=6 KV_CACHE_MEMORY=9663676416
# 262K staging:     MAX_LEN=262144 KV_CACHE_MEMORY=3221225472 MAX_SEQS=6
# profiler-sized:   unset KV_CACHE_MEMORY
