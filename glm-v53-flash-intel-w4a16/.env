# === Shared Configuration ===
# Intel W4A16-AutoRound serving profile for 2x DGX Spark (docker-compose
# conventions). Cluster values + the validated serving profile. See
# README.md for deploy steps and the profile comparison.

# Multi-node — leader node IP (same for both nodes; the RoCE rail)
MASTER_ADDR=192.168.0.170

# Serve port (cluster convention)
PORT=8000
# vLLM rendezvous port
MPORT=29521

# === Host cache paths (per node) ===
# Servable model dir produced by prepare-model.sh (hardlinks + rewritten
# config.json; see "the GPTQ surgery" in README). Runs on BOTH nodes.
MODEL_HOST_PATH=/home/sdrew/.cache/glm53-intel-w4a16/models/intel-gptq-surgery
# HF hub cache: the Intel snapshot + the DFlash2 drafter are downloaded here
# (hf download ... --revision <rev>). Mounted at /cache/huggingface.
HF_CACHE=/home/sdrew/.cache/huggingface
# Cache root: container mounts this at /cache for the JIT caches
# (torchinductor/tilelang subdirs). Node-local disk only.
CACHE_HOST_PATH=/home/sdrew/.cache/glm53-intel-w4a16

# === Network Interface Definitions (this cluster's validated NICs) ===
ETH_IF=enp1s0f0np0
ETH_IF2=enP2p1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0
# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot (GID renumbers
# across reboots; the command block resolves it per node from sysfs).
NCCL_IB_GID_INDEX=
# Rail subnet for NCCL_IB_ADDR_RANGE
NCCL_SUBNET=192.168.0.0/24

# === Runtime image (Tony sm121-v11 lineage, DFlash2 overlay baked) ===
# Base: ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2
# (digest-pinned; radixark/... is an identical alias). vLLM at
# /usr/local/lib/python3.12/dist-packages/vllm.
# DEFAULT PROFILE (dflash2pmu): locally-built image from
# dflash2-pmu128/Dockerfile (same digest-pinned base + baked
# #53388/#53906/LCM/SWA-fine-hits patches; external DFlash2 k=7 drafter at
# DFLASH_REVISION below).
IMAGE=glm53-intel-dflash2-pmu128:20260908

# === Model (Intel W4A16 AutoRound, post-surgery) ===
MODEL=Intel/GLM-5.3-Flash-W4A16-AutoRound
MODEL_REVISION=5eee1846f0321058ed73745f9aa16f2aaf0fc0a0
SERVED_MODEL_NAME=glm-5.3-flash
# Serving profile: "dflash2pmu" is the SHIPPED DEFAULT (external DFlash2
# k=7 + PMU128; vendored in dflash2-pmu128/). Alternatives — set LANE +
# IMAGE + the rows shown (see README "Switching profiles"):
#   LANE=mtp3     native MTP3 + PMU128, no drafter checkpoint
#     IMAGE=glm53-intel-mtp3-pmu128:20260907
#     KV_CACHE_MEMORY=13500000000  MAX_SEQS=6  PMU=1
#   LANE=dflash2  block-2304 prefix matching + boot-time hybrid-APC patch;
#                 uses the base image directly (no profile-image build)
#     IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2@sha256:4def0ef6…
#     DFLASH_REVISION=dc77ff1c99eeb2df044ee3d4f0094eb033fee410
#     KV_CACHE_MEMORY=12520000000  MAX_SEQS=8
LANE=dflash2pmu

# DFlash2 block-diffusion drafter (resolved from the HF cache snapshot at
# boot). CC BY-NC-ND-4.0 — NON-COMMERCIAL use only.
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=bf582e4eacc1810f76656d1811693ff6c6737d2a
# PMU128 prefix matching (dflash2pmu/mtp3: --prefix-match-unit 128 +
# --enable-prompt-tokens-details; requires the patch-baked image)
PMU=1
# mtp3 ignores the drafter (native MTP has no checkpoint); DFLASH_* is
# inert there and only used by dflash2/dflash2pmu.

GMU=0.85
MAX_LEN=1048576
MAX_SEQS=6
MNBT=8192
BLOCK_SIZE=2304
KV_DTYPE=fp8_e4m3
# 13.5 GB -> ~1.81-1.87M-token pool @1M ctx (dflash2pmu default with
# MAX_SEQS=6). PIN TRAP: --kv-cache-memory bypasses the profiler activation
# check — too high = death on the first long prompt. Empty -> profiler
# sizes it (safe fallback).
KV_CACHE_MEMORY=13500000000
# marlin is the only MoE backend that boots W4A16 on this image
# (flashinfer_cutlass is NVFP4-only -> ValueError).
MOE_BACKEND=marlin
# 1 = --enforce-eager (CUDA graphs are on by default; open A/B).
EAGER=0
# FlashInfer autotune costs ~50-85 s/boot and saved zero configs here;
# 1 = --no-enable-flashinfer-autotune.
DISABLE_FLASHINFER_AUTOTUNE=1
# 1 = --async-scheduling.
ASYNC=0
# Micro-opts, ~0 measured effect; 0 = off.
VLLM_MARLIN_USE_ATOMIC_ADD=0
VLLM_USE_FUSED_MOE_GROUPED_TOPK=0
# Indexer right-size knob; no-op unless the image consumes it. Harmless.
GLM53_INDEXER_WORKSPACE=rightsize
# Sampling / thinking defaults — explicit recipe-owned pins (temp 1.0 /
# top_p 0.95, thinking ON at REASONING_EFFORT). The vendored
# chat_template_mm.jinja honors enable_thinking + reasoning_effort;
# clients override per request via chat_template_kwargs / the OpenAI
# reasoning_effort field.
THINKING=true
REASONING_EFFORT=high
TEMPERATURE=1.0
TOP_P=0.95

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# === Alternative tuning rows (see README "Switching profiles") ===
# smaller KV pool:  MAX_SEQS=6 KV_CACHE_MEMORY=9663676416
# 262K staging:     MAX_LEN=262144 KV_CACHE_MEMORY=3221225472 MAX_SEQS=6
# profiler-sized:   unset KV_CACHE_MEMORY
