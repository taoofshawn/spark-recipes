# === Shared Configuration ===
# Adoption of the Intel W4A16-AutoRound lane (forum 382041, @miken post 5) into
# this repo's docker-compose conventions. Cluster values + the validated
# serving profile from the thread's boot receipts. See README.md for the
# provenance and config rows.

# Multi-node — leader node IP (same for both nodes; the RoCE rail)
MASTER_ADDR=192.168.0.170

# Serve port (cluster convention)
PORT=8000
# vLLM rendezvous port
MPORT=29521

# === Host cache paths (per node) ===
# Servable model dir produced by prepare-model.sh (hardlinks + rewritten
# config.json; see "GPTQ surgery" in README). Runs on BOTH nodes.
MODEL_HOST_PATH=/home/sdrew/.cache/glm53-intel-w4a16/models/intel-gptq-surgery
# HF hub cache: the Intel snapshot + the DFlash2 drafter are downloaded here
# (hf download ... --revision <rev>), so a fresh box re-populates identically.
# Mounted at /cache/huggingface (HF_HOME).
HF_CACHE=/home/sdrew/.cache/huggingface
# Cache root: container mounts this at /cache for the JIT caches
# (torchinductor/tilelang subdirs). Node-local disk only.
CACHE_HOST_PATH=/home/sdrew/.cache/glm53-intel-w4a16

# === Network Interface Definitions (this cluster's validated NICs) ===
ETH_IF=enp1s0f0np0
ETH_IF2=enP2p1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0
# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot (GID renumbers
# across reboots; the command block resolves it per node from sysfs).
NCCL_IB_GID_INDEX=
# Rail subnet for NCCL_IB_ADDR_RANGE
NCCL_SUBNET=192.168.0.0/24

# === Runtime image (Tony sm121-v11 lineage, DFlash2 overlay baked) ===
# ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2 — the image @miken
# booted ("Tony sm121-v11 lineage"). Digest-pinned 2026-09-06 (single-arm64
# manifest; radixark/vllm-glm53-flash:sm121-v11-dflash2 is the identical
# alias). vLLM at /usr/local/lib/python3.12/dist-packages/vllm.
IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2@sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6

# === Model (Intel W4A16 AutoRound, post-surgery) ===
MODEL=Intel/GLM-5.3-Flash-W4A16-AutoRound
MODEL_REVISION=5eee1846f0321058ed73745f9aa16f2aaf0fc0a0
SERVED_MODEL_NAME=glm-5.3-flash

# DFlash2 block-diffusion drafter (resolved from the HF cache snapshot at
# boot; rev = the pin our glm-v53-flash lane validates. CC BY-NC-ND-4.0 —
# NON-COMMERCIAL use only, like every DFlash2 drafter here).
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=dc77ff1c99eeb2df044ee3d4f0094eb033fee410

# === Serving profile (miken's validated row, forum 382041 post 5) ===
GMU=0.85
MAX_LEN=1048576
MAX_SEQS=8
MNBT=8192
BLOCK_SIZE=2304
KV_DTYPE=fp8_e4m3
# miken's pin: 12.52 GB -> 1.75M-token pool @1M ctx (his receipt), keeps
# >=4.3 GB host headroom through a 950K prefill. NOTE: --kv-cache-memory
# bypasses the profiler activation check (PIN TRAP: too high = death on the
# first long prompt); empty -> profiler sizes it (safe fallback). rodman80's
# 9 GiB / 1.34M-pool row: 9663676416.
KV_CACHE_MEMORY=12520000000
# marlin is the only MoE backend that boots W4A16 on this image
# (flashinfer_cutlass is NVFP4-only -> ValueError). A/B-verified by rodman80.
MOE_BACKEND=marlin
# CUDA graphs on (miken's receipts log "graphs 1..64"); rodman80 measured
# --enforce-eager neutral/better and validated EAGER=1 as their row — the A/B
# is on the research.md watchlist. 1 = --enforce-eager.
EAGER=0
# FlashInfer autotune saved zero configs on this lane and costs ~50-85 s/boot
# (rodman80, 2 boots); 1 = --no-enable-flashinfer-autotune.
DISABLE_FLASHINFER_AUTOTUNE=1
# rodman80 measured +2-3% decode, no regressions (their perf row); 0 = off.
ASYNC=0
# Micro-opts (rodman80: ~0 effect, harmless); 0 = off.
VLLM_MARLIN_USE_ATOMIC_ADD=0
VLLM_USE_FUSED_MOE_GROUPED_TOPK=0
# MiaAI's indexer right-size knob (miken: take it even on the Tony lineage —
# 5 GB back at 1M ctx; no-op if the Tony image does not consume it).
GLM53_INDEXER_WORKSPACE=rightsize
# Sampling / thinking defaults — explicit recipe-owned pins, even though they
# match the model's own generation_config.json and template defaults (parity
# with glm-v53-flash-entrpi: thinking ON at REASONING_EFFORT; temp 1.0 /
# top_p 0.95). The vendored chat_template_mm.jinja honors enable_thinking +
# reasoning_effort; clients override per request via chat_template_kwargs /
# the OpenAI reasoning_effort field.
THINKING=true
REASONING_EFFORT=high
TEMPERATURE=1.0
TOP_P=0.95

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# === Alternative rows (one-liners; see README "Profile rows") ===
# rodman80's validated 1M row:  MAX_SEQS=6 KV_CACHE_MEMORY=9663676416 EAGER=1
# rodman80's 262K staging row:  MAX_LEN=262144 KV_CACHE_MEMORY=3221225472 MAX_SEQS=6
# Profiler-sized fallback:      KV_CACHE_MEMORY=
