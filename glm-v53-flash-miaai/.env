# === Shared Configuration ===
# Adoption of MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks (see README.md for
# provenance). Cluster-specific values + the validated serving profile.

# Multi-node — leader node IP (same for both nodes)
MASTER_ADDR=192.168.0.170

# Serve port (cluster convention)
PORT=4000

# Host HF cache path. The GLM image bakes HF_HOME=/root/.cache/huggingface,
# so this host dir mounts there. EXL3 weights (~164 GiB) AND the DFlash2
# drafter must be cached on BOTH nodes (TP=2 reads on every rank).
HF_CACHE=/home/sdrew/.cache/huggingface

# Host JIT/compile-cache root: node-local disk only (container: /vllm-cache).
JIT_CACHE_DIR=/home/sdrew/.cache/vllm-glm53-miaai

# === Network Interface Definitions ===
ETH_IF=enp1s0f0np0
ETH_IF2=enP2p1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0
NCCL_IB_GID_INDEX=

# === Runtime image (public GHCR, no login; overlay is baked) ===
# Digest-pinned 2026-09-04 (verified identical on both nodes via docker
# image inspect; ghcr.io packages page confirms 2026-08-28 build). Bare-tag
# drift was a tracked risk (#97); community reports in issues #106/#119/#122
# cited a different `:exl3` digest, so this must stay pinned — re-verify
# before any image bump.
IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3@sha256:9bb1557a4234fce63d59599e44d10747eabd742beb337eebf9e7070be8a0fd58

# === Model (EXL3 4bpw) ===
MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
MODEL_REVISION=25a44fdbf16862a46b7cc9921142c6c81350af2f
SERVED_MODEL_NAME=glm-5.3-flash
DFLASH_REVISION=bf582e4eacc1810f76656d1811693ff6c6737d2a

# === Serving profile (validated on MiaAI-Lab's 2x GB10 kit) ===
# 0.8848 per boot-log hint: CUDA-graph memory profiling makes 0.87 behave
# like 0.8552; 0.8848 restores the effective KV pool (target ~690 blocks /
# ~1.75M tokens as upstream measured at 18.67 GiB available).
GPU_MEM_UTIL=0.8848
MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=7168
# Upstream #110/PR #112: an unset long-prefill threshold lets one chunked
# prefill claim the whole per-step token budget and freeze every other session.
# VALIDATED VALUE (PR#112 comments 09-03, same :exl3 image + TP=2/MNBT=7168
# geometry): threshold = MNBT/2 = 3584 is the sweet spot — freeze 150s->11s
# (14x) with NO prefill tax (95.2s vs 102.9s baseline). The PR's fixed 1024
# was measured WRONG on MNBT=7168 kits (-44% contended prefill, 182.3s);
# 3584 supersedes the 1024 adopted 09-04.
EXTRA_ARGS="--long-prefill-token-threshold 3584"
KV_CACHE_DTYPE=fp8
QUANTIZATION=exl3
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1
# PR#77 (merged 09-01) added exl3_fat_gemm E2 kernels, but ONLY to rebuilt
# images — the public :exl3 (2026-08-28, our pinned digest) does NOT contain
# exl3_fat_gemm (verified in-image 09-04), so =1 was a silent no-op that
# looked healthy. Keep 0 until we run a rebuilt image (which we don't —
# #121 shows rebuilt images corrupt long-form gen; stay on GHCR).
EXL3_FAT_KERNEL=0
# DFlash2 k=7 drafter, TP=2 (shard draft across ranks).
SPEC_METHOD=dflash
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=2
MTP_TOKENS=2
# Vision: native image + video, skip the dummy MM profile (OOM'd on this UMA).
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM={"image":10,"video":1}
# Client stop strings dormant until  response (thinking-on default).
GLM53_SUPPRESS_STOPS_IN_REASONING=1
# Upstream #119 (zankie 09-03, same :exl3 image): with `skip` (recipe
# default) a 9.5k newcomer arriving mid-decode waits the whole running
# decode -> 67-71s TTFT; at 2048 it waits only its own prefill -> 10.1s.
# #106's 75-min soak at gate=2048 did NOT freeze (negative result), so 2048
# also addresses the prefix-cache-stall watch. Tradeoff: the running stream
# drops to ~1.9 tok/s while the newcomer prefills.
GLM53_MIXED_PREFILL_CHUNK=2048
GLM53_INDEXER_WORKSPACE=stock
GLM53_SPINWAIT_MS=stock
CG_ESTIMATE=1

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
