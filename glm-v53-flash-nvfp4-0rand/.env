# === Shared Configuration ===
# GLM-5.3-Flash NVIDIA official NVFP4 + DFlash2 serving profile for 2x DGX Spark
# (docker-compose conventions). Cluster values + 0rand's launch-verified 900K
# profile. See README.md for deploy steps; research.md for provenance/receipts.

# Multi-node — leader node IP (same for both nodes; the RoCE rail)
MASTER_ADDR=192.168.0.170

# Serve port (cluster convention; clients reach the model through the
# model-name proxy on :4000 with model spark-llm)
PORT=8000
# vLLM rendezvous port
MPORT=29521

# === Host cache paths (per node) ===
# HF hub cache: the NVFP4 checkpoint + the DFlash2 drafter are downloaded here
# (hf download ... --revision <rev>) and resolved to their snapshot dirs at
# boot. No surgery step — the NVFP4 checkpoint loads natively on the image.
HF_CACHE=/home/sdrew/.cache/huggingface
# Cache root: container mounts this at /cache for the JIT caches. Node-local disk only.
CACHE_HOST_PATH=/home/sdrew/.cache/glm53-nvfp4-0rand

# === Network Interface Definitions (this cluster's validated NICs) ===
ETH_IF=enp1s0f0np0
ETH_IF2=enP2p1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0
# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot (GID renumbers
# across reboots; the command block resolves it per node from sysfs).
NCCL_IB_GID_INDEX=
# Rail subnet for NCCL_IB_ADDR_RANGE
NCCL_SUBNET=192.168.0.0/24

# === Runtime image (pilcothink 0.28; supplies the b12x backends + sparse-MLA
# attention default; vLLM 0.28.1rc1.dev475+g6fbb00b18) ===
IMAGE=pilcothink/vllm_spark_glm53:0.28

# === Model (NVIDIA official NVFP4; ships NO MTP heads -> external drafter
# mandatory). Served straight from the HF snapshot — no surgery. ===
MODEL=nvidia/GLM-5.3-Flash-NVFP4
MODEL_REVISION=09b04e5e74bca08ca8549fc736d4cdd8624bfde3
SERVED_MODEL_NAME=glm-5.3-flash

# === DFlash2 block-diffusion drafter (resolved from the HF cache at boot) ===
# CC BY-NC-ND-4.0 — NON-COMMERCIAL use only.
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
# Upstream does not pin a drafter revision (DRAFT_NAME=glm53-dflash2-orig);
# this is the intel recipe's dflash2pmu pin (HF HEAD as of 2026-09-08).
# See research.md watchlist.
DFLASH_REVISION=bf582e4eacc1810f76656d1811693ff6c6737d2a
# 5 = 0rand's default; 4 = jetspark's faster row; 7 = the official set.
DFLASH_TOKENS=5
# 1 = 0rand's RECIPE_SPEC_EXTRAS spec-config extras (probabilistic draft
# sampling, standard rejection, no adaptive verification, block-drop NOT
# disabled). 0 = bare {method, model, k, attention_backend, kv_cache_dtype}.
SPEC_EXTRAS=1

# === Memory / schedule (middle-ground profile: 0rand's quality-verified 700K
# ctx + seqs 4 + MNBT 2048 for prefill speed; 9 GiB pin kept) ===
# GMU WARNING: on the pilcothink build this is a FATAL pre-load check against
# whole-system RAM. 0.88 was 0rand's measured ceiling on HIS host — if boot
# dies ~45 s in with "Free memory on device ... is less than desired GPU
# memory utilization", lower it and re-measure (README "Known issues").
GMU=0.88
MAX_LEN=700160
MAX_SEQS=4
MNBT=2048
BLOCK_SIZE=256
KV_DTYPE=fp8
# 9 GiB pin -> ~1.08M-token pool @900K ctx (upstream measured). Empty ->
# GMU-driven sizing (no pin). The pin does NOT bypass the GMU gate.
KV_CACHE_MEMORY=9663676416
# CUDA graphs <=16 capture (a KV-budget lever, not just a perf knob)
CAPTURE_SIZE=16
# 1 = --async-scheduling
ASYNC=1
# 1 = --enforce-eager (kills CUDA graphs; frees ~4 GiB of pool at capture <=64)
EAGER=0
# vLLM >= v0.21 graph-mode memory estimator reserves ~2.1 GiB of KV; 0 = off
# (upstream default). Mapped to VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS.
ESTIMATE_CUDAGRAPHS=0
# b12x is the image's NVFP4 backend (start.sh passes both explicitly);
# ATTN_BACKEND empty = image default (sparse-MLA).
MOE_BACKEND=b12x
LINEAR_BACKEND=b12x
ATTN_BACKEND=
# 1 = --no-enable-flashinfer-autotune (upstream passes it)
DISABLE_FLASHINFER_AUTOTUNE=1

# === Sampling / thinking defaults (repo-standard pins; server-side so a
# checkpoint/template refresh cannot silently drift them) ===
THINKING=true
REASONING_EFFORT=high
TEMPERATURE=1.0
TOP_P=0.95

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# === Alternative tuning rows (see README "Tuning rows") ===
# quality-verified 700K: MAX_LEN=700160
# 524K concurrency row:  MAX_LEN=524288 MAX_SEQS=2 MNBT=8192 KV_CACHE_MEMORY=6979321856
# upstream launch-verified 1M (2026-09-22, pool 1,172,644): MAX_LEN=1048576
#                        KV_CACHE_MEMORY=10240000000  (batch 1024 upstream;
#                        post 82 reports 4096; raise the pin only after your
#                        own boot proves the headroom — fatal GMU gate above)
# faster decode (k=4):   DFLASH_TOKENS=4
# eager (no graphs):     EAGER=1
# display-KV (+18.4% KV, EXPERIMENTAL): NOT a .env line here — upstream's
#                        start-display-kv.sh variant requires a runtime nvidia_drm
#                        reload + passwordless sudo on the worker (AGPL allocator;
#                        see README "Display-KV variant")
