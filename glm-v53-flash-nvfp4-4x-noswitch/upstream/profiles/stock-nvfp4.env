# Sourced by site/env.switchless INSTEAD of profiles/current.env.
# It sources upstream profiles/current.env first, then applies the stock-nvfp4 delta.
# Rationale (research.md §3): this lane serves the PRISTINE nvidia/GLM-5.3-Flash-NVFP4
# checkpoint — no lossless8 conversion, no drafter FP8 re-encode — so every switch that
# assumes those derived artifacts must be stripped. Everything else in current.env is
# inherited automatically so upstream kernel/scheduler wins keep arriving.

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/current.env"

# --- Strip list: switches that assume the lossless8 target and/or fp8blk drafter -------
# Verified against profiles/current.env @ upstream pin 770d115 (research.md §3).
#   QMIX_FP8_BLOCK / VLLM_TEST_FORCE_FP8_MARLIN / QMIX_DEBUG_LAYERS
#       lossless8 overlay loader filter + sentinel — no overlay exists on the stock pack.
#   GLM_DENSE_FAST / GLM_DENSE_FAST_PREFILL
#       8-bit-grid dense GEMM kernels; the stock pack's dense layers are BF16.
#   GLM_DS_DRAFT_HEAD_FP8 / GLM_LV_DRAFT_FP8_KV
#       assume the fp8blk-converted drafter; this lane serves the stock bf16 drafter.
for kv in QMIX_FP8_BLOCK=1 VLLM_TEST_FORCE_FP8_MARLIN=1 QMIX_DEBUG_LAYERS=1 \
          GLM_DENSE_FAST=1 GLM_DENSE_FAST_PREFILL=1 \
          GLM_DS_DRAFT_HEAD_FP8=1 GLM_LV_DRAFT_FP8_KV=1; do
  EXTRA_ENV="${EXTRA_ENV/ ${kv}/}"
done

# --- shawndo site serving values --------------------------------------------------------
# 1M context (model-native max) on a conservative ~3.2M-token pool: 20 GiB/rank KV pin
# (80 GiB total at the measured ~40.6K fp8-KV tokens/GiB → ~3.25M tokens → 3.1× full-1M
# concurrency). Ladder 24→28 GiB/rank only behind gates (research.md §4).
MAX_MODEL_LEN=1048576
KV_BYTES=21474836480
# Repo conventions (port 8000 / glm-5.3-flash / host-network bind), NOT upstream's
# loopback :8093 GLM-5.3-Flash-FP8 — the model-name proxy and agents depend on these.
SERVED_NAME=glm-5.3-flash
PORT=8000
HOST_BIND=0.0.0.0
# GPU_UTIL 0.78 inherited from current.env: stock weights ~47.6 GiB/rank + 20 GiB KV +
# graphs/activations fits with margin on 128 GB GB10 nodes.
