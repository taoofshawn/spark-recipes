# cluster.env — fabric + host facts for the glm-v53-flash-nvfp4-tp4-switchless recipe.
#
# This file is the lane's OWN copy of the cluster-level facts (D1: full vendoring). Nothing
# here reads a sibling recipe. It is sourced by this recipe's vendored fabric tooling:
#
#   site/fabric/scripts/render-netplan.sh     netplan + iptables env are DERIVED from here
#   site/fabric/scripts/bootstrap-node.sh     host bootstrap (packages, sudoers, /etc, ssh)
#   site/fabric/scripts/deploy-host.sh         /etc + netplan install, sha-verified
#   site/fabric/preflight.sh                   read-only verification, prints CONTRACT_DIGEST
#
# `tp4_load_env` sources THIS file as `$REPO/cluster.env` (REPO = site/fabric), so the
# scripts above keep their upstream load path unchanged.
#
# The contract values below are duplicated in every recipe on purpose (D2). They must stay
# semantically identical: CONTRACT_DIGEST lets three lanes be compared in one line.
# Serve values (IMAGE, MODEL_DIR, KV, MAX_MODEL_LEN, …) live in site/env.switchless.

# --- Topology: ssh aliases and mgmt IPs, rank order 0..3 ------------------------------
NODES="spark-0f0b spark-6d14 spark-6d90 spark-6d24"
NODE_HOSTNAMES="spark-0f0b spark-6d14 spark-6d90 spark-6d24"
MGMT_IPS="10.69.43.170 10.69.43.171 10.69.43.172 10.69.43.173"

# --- Distributed rendez-vous and management network ----------------------------------
MASTER_IP="10.69.43.170"
MASTER_PORT=29520
MGMT_IF=wlP9s9
MGMT_IF_BY_RANK=()
API_PORT=8000

# --- Fabric ring topology. Index = rank; each entry = that rank's two ring peers ------
# Address plan: node N on ring link L is 10.10.<L>.<N>/24, L = 1..4 walking
# rank0 -> rank1 -> rank2 -> rank3 -> rank0. P2 (second PCIe view) octet = f octet + 2.
FABRIC_TARGETS=(
  "10.10.1.2 10.10.4.4"
  "10.10.1.1 10.10.2.3"
  "10.10.2.2 10.10.3.4"
  "10.10.3.3 10.10.4.1"
)

# Hardware profile (ASUS Ascent GX10 / 4x GB10), NOT a site value: the two ends of this
# node's ring links first (f0, f1), then the second PCIe view of the same transceivers.
FABRIC_IFACES="enp1s0f0np0 enp1s0f1np1 enP2p1s0f0np0 enP2p1s0f1np1"
FABRIC_IFACES_BY_RANK=()
FABRIC_P2_VIEWS=1                 # address the P2 views (octet = f octet + 2)
NETPLAN_RENDERER=NetworkManager
NETPLAN_RENDERER_BY_RANK=()

# --- Four-PF NCCL contract (duplicated per lane — see CONTRACT_DIGEST below) ----------
# RoCE device order matches FABRIC_IFACES: f0, f1, P2-of-f0, P2-of-f1.
NCCL_IB_HCA="rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1"
NCCL_IB_HCA_BY_RANK=()
NCCL_4PF_SHA256=8de68def30bcde20fabded468bd60f0df82ea12d3ead02d5120c7feda7a41a87
# 2-PF SparkRing build — this lane's documented rollback, vendored under site/nccl-2pf/.
NCCL_2PF_SHA256=afe5f48626284eae89988516e450c7f20cc303904ba4b7083b88aa3ca1e9b85f

# --- Contract digest -------------------------------------------------------------------
# sha256 over the canonical newline-joined list (order matters):
#   net=10.10.{1,2,3,4}.0/24        (the four ring /24s)
#   p2_octet_rule=f_octet+2
#   hca=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
#   flag=NCCL_SWITCHLESS_RING_ONLY=1
#   flag=NCCL_IB_MERGE_NICS=0
#   flag=NCCL_IB_EXTENDED_IPV4_GIDS=1
#   flag=NCCL_IB_PRESERVE_PCI_DOMAIN=1
# A change to ANY of those is a deliberate three-lane change; this digest makes an
# accidental single-lane edit visible without a shared script. Print it from preflight.
CONTRACT_DIGEST=ebb9733317a47032e5e17fe37ba7dfcb3c30f006333bbda3eb27a5ba3103f323