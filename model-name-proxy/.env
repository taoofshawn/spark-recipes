# Shared config for the model-name-proxy service (leader node only).
#
# Response spoofing toggle:
#   1 = full spoof (responses say "spark-model" everywhere)  [default]
#   0 = mode A: responses show the REAL backend name (e.g. deepseek-v4-flash)
#       so you can tell which model is active; clients still send "spark-model".
SPOOF_RESPONSES=0

# The proxy listens on :4000 and forwards to the vLLM backend on :8000.
# Recipes serve on :8000 (their .env PORT=8000); clients never change.

# Name every client sees, regardless of which recipe is running.
SPOOF_MODEL=spark-model

# The ACTIVE recipe's --served-model-name. MUST be updated when switching
# backends:
#   deepseek-v4-flash-aiden            -> deepseek-v4-flash
#   deepseek-v4-flash-tonyd2wild       -> deepseek-v4-flash-dspark
#   deepseek-v4-flash-vision-miaai     -> deepseek-v4-flash
#   glm-v53-flash / -miaai / -intel    -> glm-5.3-flash
#   glm-v53-flash-entrpi               -> glm-5.3-flash
#   mimo-v25-dflash-tonyd2wild         -> mimo-v25-dflash
BACKEND_MODEL=deepseek-v4-flash

# Response spoofing list: every real name that may appear in backend responses.
# Add new recipe names here when they land.
SPOOF_FROM=deepseek-v4-flash,deepseek-v4-flash-dspark,glm-5.3-flash,GLM-5.3-Flash-EXL3,mimo-v25-dflash

# Backend address (host networking; vLLM binds 0.0.0.0:8000 on the leader).
UPSTREAM=127.0.0.1:8000
