# Shared config for the model-name-proxy service (leader node only).
#
# Response spoofing toggle:
#   1 = full spoof (responses say "spark-llm" everywhere)  [default]
#   0 = mode A: responses show the REAL backend name (e.g. deepseek-v41-flash)
#       so you can tell which model is active; clients still send "spark-llm".
SPOOF_RESPONSES=0

# The proxy listens on :4000 and forwards to the vLLM backend on :8000.
# Recipes serve on :8000 (their .env PORT=8000); clients never change.

# Name every client sees, regardless of which recipe is running.
SPOOF_MODEL=spark-llm

# The ACTIVE recipe's --served-model-name. The proxy rewrites every request's "model" field
# to this value, so it MUST match whichever recipe is serving — flip it on EVERY lane change
# (plus recreate) and verify one chat request round-trips:
#   glm-v53-flash-fp8-tp4-switchless     -> glm-5.3-flash
#   glm-v53-flash-nvfp4-tp4-switchless   -> glm-5.3-flash      (same value as FP8)
#   deepseek-v41-flash-tp4-switchless    -> deepseek-v41-flash
#   deepseek-v41-flash-christopherowen   -> deepseek-v41-flash   (same value as the SGLang lane)
# A mismatch does not look like a proxy error: /v1/models still reports the right context, but
# every chat completion 404s with "The model <stale name> does not exist". Verified live
# 2026-11-21 (backend on a GLM lane while this was still deepseek-v41-flash).
# GLM<->GLM needs no edit because the value is identical; DeepSeek<->GLM needs one.
BACKEND_MODEL=deepseek-v41-flash

# Response spoofing list: a SUPERSET of every real name an operator may switch to.
# Deleting a recipe means deleting its name here ONLY IF no other recipe serves that name
# (this is why BACKEND_MODEL, not SPOOF_FROM, is the per-switch knob).
SPOOF_FROM=deepseek-v41-flash,glm-5.3-flash

# Backend address (host networking; vLLM binds 0.0.0.0:8000 on the leader).
UPSTREAM=127.0.0.1:8000
