# Shared config for the model-name-proxy service (leader node only).
#
# Response spoofing toggle:
#   1 = full spoof (responses say "spark-llm" everywhere)  [default]
#   0 = mode A: responses show the REAL backend name (e.g. deepseek-v41-flash)
#       so you can tell which model is active; clients still send "spark-llm".
SPOOF_RESPONSES=0

# The proxy listens on :4000 and forwards to the vLLM backend on :8000.
# Recipes serve on :8000 (their .env PORT=8000); clients never change.

# Name every client sees, regardless of which recipe is running.
SPOOF_MODEL=spark-llm

# The ACTIVE recipe's --served-model-name. MUST be updated when switching
# backends:
#   deepseek-v41-flash-tp4-switchless      -> deepseek-v41-flash
#   glm-v53-flash-fp8/nvfp4-tp4-switchless -> glm-5.3-flash
BACKEND_MODEL=deepseek-v41-flash

# Response spoofing list: every real name that may appear in backend responses.
# The three switchless recipes serve deepseek-v41-flash and glm-5.3-flash.
SPOOF_FROM=deepseek-v41-flash,glm-5.3-flash

# Backend address (host networking; vLLM binds 0.0.0.0:8000 on the leader).
UPSTREAM=127.0.0.1:8000
