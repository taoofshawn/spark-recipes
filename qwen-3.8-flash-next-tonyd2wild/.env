# === Shared Configuration ===
# qwen-3.8-flash-next-tonyd2wild — NVIDIA's official NVFP4 quant of
# Qwen3.8-Flash-Next on 2× DGX Spark (TP2), adopted from
# tonyd2wild/Qwen3.8-Flash-Next-NVFP4-DGX-Spark (forum 382476, TP2 SPEED
# profile) into this repo's docker-compose conventions.
#
# Upstream pins (2026-09-07): image vllm/vllm-openai:nightly-8a728663c…
# (2026-09-04 nightly), model nvidia/Qwen3.8-Flash-Next-NVFP4 @ fc694b54…

# Multi-node — leader node IP (same for both nodes; the RoCE rail)
MASTER_ADDR=192.168.0.170

# Serve port (cluster convention; the model-name proxy fronts :4000)
PORT=8000
# vLLM rendezvous port (upstream TP2 launcher default)
MPORT=29531

# === Host cache paths (per node) ===
# The NVFP4 checkpoint: 124 GB on disk. EACH rank needs a readable local copy.
# Provision with a plain HF download into the default cache (no path editing):
#   hf download nvidia/Qwen3.8-Flash-Next-NVFP4 --revision fc694b54fb0174e0913e6adf86691ef85a4ead47
# then point HF_CACHE at your default HF home. The boot block resolves
# hub/models--nvidia--Qwen3.8-Flash-Next-NVFP4/snapshots/<MODEL_REVISION>
# inside the container (upstream's /var/tmp/... convention is gone — the
# default HF cache location is the contract now; MODEL_REVISION picks the
# snapshot).
HF_CACHE=/home/sdrew/.cache/huggingface
# Cache root: container mounts this at /root/.cache (torch/inductor caches).
# Node-local disk only.
CACHE_HOST_PATH=/home/sdrew/.cache/qwen38fn

# === Network Interface Definitions (this cluster's validated NICs) ===
ETH_IF=enp1s0f0np0
IB_PORTS=rocep1s0f0,roceP2p1s0f0
# RoCE-v2 IPv4 GID index. Leave empty to auto-detect at boot (GID renumbers
# across reboots; the command block resolves it per node from sysfs).
# Upstream hardcodes 3 — do NOT copy; our cluster auto-detects.
NCCL_IB_GID_INDEX=
# Rail subnet for NCCL_IB_ADDR_RANGE (upstream: 192.168.192.0/24 on their kit)
NCCL_SUBNET=192.168.0.0/24

# === Runtime image ===
# Stock vLLM nightly — no custom GHCR image in this lane; the overlays in
# patches/ are bind-mounted at boot (upstream's OVERLAYS=1 mechanism).
# Digest-pin when adopting (upstream ships the tag only).
IMAGE=vllm/vllm-openai:nightly-8a728663c1c3eeace834a95f5654fa653cc1998c

# === Model ===
MODEL=nvidia/Qwen3.8-Flash-Next-NVFP4
MODEL_REVISION=fc694b54fb0174e0913e6adf86691ef85a4ead47
SERVED_MODEL_NAME=qwen3.8-flash-next

# === Serving profile (upstream TP2 SPEED default, forum 382476 post 1) ===
# Receipts: 53.7 tok/s median single stream, 97.9 aggregate @6, 180 ms TTFT,
# KV pool 1.97M tokens @ 262K ctx (7 full contexts), cold prefill 2,784 tok/s
# @28K. GMU 0.70 is deliberate: the head sits near the ~10 GB MemAvailable
# danger line; 0.75+ risks swap (blazux: 0.85 drifts into swap, 0.875
# OOM-killed on a 300K prefill).
GMU=0.70
MAX_LEN=262144            # the model's native context (text_config 262144)
MAX_SEQS=6
MNBT=4096                 # the single biggest speed lever measured on GB10
KV_DTYPE=fp8_e4m3         # needs the #54846 QSA overlay (stock refuses fp8 KV on this model)
MTP=3                     # MTP3 — MTP4 trails at every load (README table)
# CUDA graphs for decode WITHOUT torch.compile. NEVER pair the 4096 chunk
# with compile on: measured 8–15 tok/s decode (README gotcha). Compile's
# Inductor autotune also duplicates the resident 47.7 GB PLE table
# (~24 GB/rank) — starved/rebooted three Sparks before the cause was found.
GRAPHS=nocompile
# Prefix caching OFF until vLLM #54173 (GDN prefix-cache crash) is verified
# fixed in this nightly. 1 = --enable-prefix-caching (upstream PREFIX_CACHE_ARG).
PREFIX_CACHE=0
# PLE n-gram table placement: "none" = stock loader, table resident in
# unified memory (SPEED default, needs GRAPHS=nocompile); "mmap" = table on
# NVMe, rows gathered per step (CONTEXT profile: 5.87M pool, needs
# GRAPHS=piecewise + the ple_* overlays; ~36 tok/s median but 22 concurrent
# 262K contexts). Do NOT use "resident"/"staged" (experimental, measured
# slow in this build).
PLE_MODE=none
# Optional: reduced-vocabulary MTP draft (DRAFT_VOCAB=65536) — measured
# prose +10% at TP2, TTFT ~0.1 s worse at load; NOT default upstream.
DRAFT_VOCAB=
# Tool parser: qwen3_xml (default) or qwen3_coder
TOOL_PARSER=qwen3_xml
# FlashInfer autotune: disabled upstream (autotune-cache failures on GB10)
DISABLE_FLASHINFER_AUTOTUNE=1
# ASYNC_SCHED=1 adds --async-scheduling — measured -3% upstream, off here.
ASYNC=0

# === Sampling / thinking defaults (repo parity with the other recipes) ===
# Upstream pins thinking OFF server-side (--default-chat-template-kwargs
# {"enable_thinking": false}) and ships no temp/top_p overrides. This repo's
# convention is explicit pins; they are no-ops vs upstream behavior.
THINKING=false
TEMPERATURE=1.0
TOP_P=0.95

# === Overlays (bind-mounted at boot; upstream OVERLAYS=1 mechanism) ===
# The five upstream-overlays + (PLE_MODE != none) the ple_layer/ple_mmap pair
# are mounted onto /usr/local/lib/python3.12/dist-packages/vllm/... paths.
# Leave at 1 — without them fp8 KV and the MTP head fail to load.
OVERLAYS=1

# === Offline serving ===
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
